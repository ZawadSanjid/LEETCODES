Input: s = "Hello World"
Output: 5
Explanation: The last word is "World" with length 5.

class Solution {
public:
    int lengthOfLastWord(string s) {
         int len = 0;

        // start from last character
        for(int i = s.length() - 1; i >= 0; i--)
        {
            // ignore spaces at the end
            if(s[i] == ' ' && len == 0)
            {
                continue;
            }

            // stop when space comes after word
            if(s[i] == ' ')
            {
                break;
            }

            len++;
        }

        return len;
    }
};

